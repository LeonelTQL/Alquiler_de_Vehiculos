                    <button class="btn btn-info" onclick="Editar(2)">Ver Detalles</button>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card" onclick="Editar(3)">
                <img src="\sources\car3.png" class="card-img-top" alt="Vehículo 3" height="160">
                <div class="card-body">
                    <h5 class="card-title">Ford Focus</h5>
                    <button class="btn btn-info" onclick="Editar(3)">Ver Detalles</button>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card" onclick="Editar(4)">
                <img src="\sources\car4.png" class="card-img-top" alt="Vehículo 4" height="160">
                <div class="card-body">
                    <h5 class="card-title">Chevrolet Malibu</h5>
                    <button class="btn btn-info" onclick="Editar(4)">Ver Detalles</button>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card" onclick="Editar(5)">
                <img src="\sources\car5.png" class="card-img-top" alt="Vehículo 5" height="160">
                <div class="card-body">
                    <h5 class="card-title">Nissan Altima</h5>
                    <button class="btn btn-info" onclick="Editar(5)">Ver Detalles</button>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card" onclick="Editar(6)">
                <img src="\sources\car6.png" class="card-img-top" alt="Vehículo 6" height="160">
                <div class="card-body">
                    <h5 class="card-title">Mazda 3</h5>
                    <button class="btn btn-info" onclick="Editar(6)">Ver Detalles</button>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card" onclick="Editar(7)">
                <img src="\sources\car7.png" class="card-img-top" alt="Vehículo 7" height="160">
                <div class="card-body">
                    <h5 class="card-title">Volkswagen Jetta</h5>
                    <button class="btn btn-info" onclick="Editar(7)">Ver Detalles</button>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card" onclick="Editar(8)">
                <img src="\sources\car8.png" class="card-img-top" alt="Vehículo 8" height="160">
                <div class="card-body">
                    <h5 class="card-title">Hyundai Elantra</h5>
                    <button class="btn btn-info" onclick="Editar(8)">Ver Detalles</button>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card" onclick="Editar(9)">
                <img src="\sources\car9.png" class="card-img-top" alt="Vehículo 9" height="160">
                <div class="card-body">
                    <h5 class="card-title">Kia Forte</h5>
                    <button class="btn btn-info" onclick="Editar(9)">Ver Detalles</button>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card" onclick="Editar(10)" >
                <img src="\sources\car10.png" class="card-img-top" alt="Vehículo 10" height="160">
                <div class="card-body">
                    <h5 class="card-title">Subaru Impreza</h5>
                    <button class="btn btn-info" onclick="Editar(10)">Ver Detalles</button>
                </div>
            </div>
        </div>
    </div>

    <form id="frmGuardarReservas" method="post">
        <h2 class="text-center">Registra tu reserva</h2>
        <div class="card mb-4">
            <div class="card-body">
                <div class="row">
                    <input type="hidden" class="form-control" value="1" name="idCliente">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="vehiculoId">Vehículo:</label>
                            <select class="form-control" id="cboVehiculo" name="idVehiculo">
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="fechaInicio">Fecha Inicio:</label>
                            <input type="date" class="form-control" id="txtfechaInicio" name="fechaInicio">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="fechaFin">Fecha Fin:</label>
                            <input type="date" class="form-control" id="txtfechaFin" name="fechaFin">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <input type="hidden" class="form-control" value="Confirmada" name="estado">
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="gap-2">
                        <button type="button" onclick="guardarReservas()" class="btn btn-primary">
                            Guardar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Modal para Detalles del Vehículo -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Vehiculo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="frmEditarVehiculos" method="post">
                    <input type="hidden" class="form-control" id="txtidVehiculoModal" name="idVehiculo" >
                    <div class="md-3">
                        <div class="form-group">
                            <label for="marca">Marca:</label>
                            <input type="text" class="form-control" id="txtmarcaModal" name="marca" readonly>
                        </div>
                    </div>
                    <div class="md-3">
                        <div class="form-group">
                            <label for="modelo">Modelo:</label>
                            <input type="text" class="form-control" id="txtmodeloModal" name="modelo" readonly>
                        </div>
                    </div>
                    <div class="md-3">
                        <div class="form-group">
                            <label for="anio">Año:</label>
                            <input type="text" class="form-control" id="txtanioModal" name="anio" readonly>
                        </div>
                    </div>
                    <div class="md-3">
                        <div class="form-group">
                            <label for="precio">Precio:</label>
                            <input type="text" class="form-control" id="txtprecioModal" name="precio" readonly>
                        </div>
                    </div>
                    <div class="md-3">
                        <div class="form-group">
                            <label for="estado">Estado:</label>
                            <input type="text" class="form-control" id="txtestadoModal" name="estado" readonly>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        setTimeout(() => {
            cargarVehiculos();
        }, 500);
    });
</script>
