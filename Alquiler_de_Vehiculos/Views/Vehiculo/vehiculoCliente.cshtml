@{
    ViewData["Title"] = "vehiculoCliente";
}
<script src="~/js/reservas.js"></script>
<script src="~/js/vehiculo.js"></script>
<script src="~/js/generic.js"></script>



<div class="container">
    <h2 class="text-center">Selecciona un Vehículo</h2>
    <div class="row" id="vehiculosContainer">
        <div class="col-md-4 mb-3">
            <div class="card" onclick="Editar(1)" >
                <img src="\sources\car1.png" class="card-img-top" alt="Vehículo 1" height="160">
                <div class="card-body" >
                    <h5 class="card-title">Toyota Corolla</h5>
                    <button class="btn btn-info" onclick="Editar(1)">Ver Detalles</button>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card" onclick="Editar(2)">
                <img src="\sources\car2.png" class="card-img-top" alt="Vehículo 2" height="160">
                <div class="card-body">
